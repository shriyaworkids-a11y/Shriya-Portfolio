{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Shriya's Remake/index.html"
    },
    {
      "source": "/about",
      "destination": "/Shriya's Remake/about.html"
    },
    {
      "source": "/work",
      "destination": "/Shriya's Remake/work.html"
    },
    {
      "source": "/contact",
      "destination": "/Shriya's Remake/contact.html"
    },
    {
      "source": "/privacy-statement",
      "destination": "/Shriya's Remake/privacy-statement.html"
    },
    {
      "source": "/pixel-design-system",
      "destination": "/Shriya's Remake/pixel-design-system/index.html"
    },
    {
      "source": "/pixel-design-system/",
      "destination": "/Shriya's Remake/pixel-design-system/index.html"
    },
    {
      "source": "/pixel-design-system/index.html",
      "destination": "/Shriya's Remake/pixel-design-system/index.html"
    },
    {
      "source": "/pixel-design-system/css/:path*",
      "destination": "/Shriya's Remake/pixel-design-system/css/:path*"
    },
    {
      "source": "/pixel-design-system/js/:path*",
      "destination": "/Shriya's Remake/pixel-design-system/js/:path*"
    },
    {
      "source": "/projecten/pixel-design-system",
      "destination": "/Shriya's Remake/projecten/pixel-design-system.html"
    },
    {
      "source": "/projecten/pixel-design-system.html",
      "destination": "/Shriya's Remake/projecten/pixel-design-system.html"
    },
    {
      "source": "/((?!Shriya's Remake/).*)",
      "destination": "/Shriya's Remake/$1"
    }
  ]
}
