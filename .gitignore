# ===================================================
# Shriya's Portfolio — .gitignore
# ===================================================

# 1. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# 2. Editor & IDE Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# 3. Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert

# 4. Dependency Directories
node_modules/
jspm_packages/
.pnp
.pnp.js

# 5. Build Outputs & Caches
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.cache/
.parcel-cache/

# 6. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Python Temporary / Cache Files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 8. Temporary & Local Scripts
powershell.cmd
*.tmp
*.temp
